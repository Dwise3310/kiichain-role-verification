# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="KiiChain Role Verification Portal"

# ── NextAuth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Discord OAuth (Discord Developer Portal → OAuth2) ───────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Server the user must belong to
DISCORD_GUILD_ID=
# Bot token with "Server Members Intent" enabled, used server-side only
# to read guild roles for the authenticated user (never sent to client)
DISCORD_BOT_TOKEN=

# Comma-separated Discord role IDs that qualify for verification.
# Get role IDs with Developer Mode on in Discord (right-click role → Copy ID).
ELIGIBLE_ROLE_IDS=

# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ────────────────────────────────────────────────────────
# bcrypt hash of the admin password. Generate with:
# node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# ── WalletConnect (optional, for the WalletConnect modal) ────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=c4edd7f93c33f0b948933ea1649ba4eb

# ── Rate limiting (optional — Upstash Redis) ─────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
